{% extends 'base.html.twig' %}
{% block title %}{{ mode == 'create' ? 'Novo produto' : 'Editar produto' }}{% endblock %}
{% block body %}
<h1>{{ mode == 'create' ? 'Novo produto' : 'Editar produto' }}</h1>
{{ form_start(form, {attr:{class:'card'}}) }}
{{ form_errors(form) }}
<div class="grid">{{ form_row(form.name) }}{{ form_row(form.sku) }}{{ form_row(form.category) }}{{ form_row(form.price) }}{{ form_row(form.stock) }}{{ form_row(form.status) }}</div>
{{ form_row(form.description) }}{{ form_row(form.image) }}
<p><button>Salvar</button> <a href="{{ path('products_index') }}">Cancelar</a></p>
{{ form_end(form) }}
{% endblock %}
